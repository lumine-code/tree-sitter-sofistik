{
  "name": "@lumine-code/tree-sitter-sofistik",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Parses SOFiSTiK CADINP input with Tree-sitter.",
  "main": "bindings/node",
  "types": "bindings/node",
  "repository": "https://github.com/lumine-code/tree-sitter-sofistik",
  "bugs": "https://github.com/lumine-code/tree-sitter-sofistik/issues",
  "homepage": "https://github.com/lumine-code/tree-sitter-sofistik",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.16.0",
  "keywords": [
    "tree-sitter",
    "sofistik",
    "cadinp",
    "structural-engineering",
    "finite-element-analysis",
    "lumine"
  ],
  "files": [
    "bindings/node",
    "grammar.js",
    "include",
    "schema/provenance.json",
    "src",
    "tree-sitter.json",
    "binding.gyp"
  ],
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lumine-code/sofistik-schema": "github:lumine-code/sofistik-schema#51580a8c7eec1c54ca1916576432a0f99a7f6ed6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tree-sitter": "^0.25.1",
    "tree-sitter-cli": "0.27.0",
    "web-tree-sitter": "0.27.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "build": "npm run build:native",
    "build:native": "node-gyp rebuild",
    "build:wasm": "node scripts/build-wasm.js",
    "check:format": "prettier --check .",
    "check:generated": "node scripts/check-generated.js",
    "generate": "npm run generate:schema --silent && tree-sitter generate",
    "generate:schema": "node scripts/generate-schema.js",
    "install": "node-gyp-build",
    "lint": "eslint .",
    "test": "npm run lint && npm run check:format && npm run check:generated && npm run build && npm run test:node && npm run test:wasm && tree-sitter test",
    "test:corpus": "node scripts/test-corpus.js",
    "test:fuzz": "tree-sitter fuzz --iterations 100 --edits 5",
    "test:node": "node --test --test-concurrency=1 bindings/node/binding_test.js test/corpus-runner.test.js test/external-contract.test.js test/generate-schema.test.js test/parser.test.js test/regressions.test.js",
    "test:wasm": "node --test test/wasm.test.js test/wasm-regressions.test.js test/wasm-includes.test.js"
  }
}
